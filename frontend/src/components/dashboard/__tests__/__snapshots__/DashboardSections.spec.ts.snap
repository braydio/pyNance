// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Dashboard section components > renders net overview content and forwards slot content 1`] = `
"<section data-v-26cbed55="" class="flex flex-col gap-6">
  <header data-v-26cbed55="" class="net-overview-context" data-testid="net-overview-context">
    <h2 data-v-26cbed55="" class="net-overview-context__title">Overview</h2>
    <p data-v-26cbed55="" class="net-overview-context__meta">January 1, 2025</p>
    <p data-v-26cbed55="" class="net-overview-context__status" data-testid="activity-status"> Activity note: Largest expense was Rent.</p>
    <!--v-if-->
  </header>
  <!--v-if-->
  <!-- Tier 1: Now -->
  <div data-v-26cbed55="" class="grid grid-cols-1 gap-4 lg:grid-cols-3 items-stretch" data-testid="now-tier">
    <div data-v-26cbed55="" class="surface-primary p-4 md:p-5 flex flex-col lg:col-span-1"><button data-v-26cbed55="" class="safe-spend-stub">Safe Spend</button>
      <p data-v-26cbed55="" class="text-sm text-muted mt-2" data-testid="safe-to-spend-scope"> Current guidance (not filtered by chart dates) </p>
    </div>
    <div data-v-26cbed55="" class="surface-normal p-4 md:p-5 flex flex-col gap-3" data-testid="transactions-card">
      <h3 data-v-26cbed55="" class="text-sm font-semibold">Transactions</h3>
      <p data-v-26cbed55="" class="net-overview-review-status-text" role="status">12 transactions in selected period</p>
      <div data-v-26cbed55="" class="flex flex-wrap items-center gap-2 mt-auto"><button data-v-26cbed55="" class="btn btn-outline net-overview-review-status" type="button" aria-label="12 transactions in selected period. Open transaction review."> Review transactions </button><button data-v-26cbed55="" class="net-overview-refine-toggle" type="button" aria-expanded="false">Filter by tag</button></div>
      <!--v-if-->
    </div>
    <div data-v-26cbed55="" class="surface-normal p-4 md:p-5 flex flex-col gap-2" data-testid="cash-direction">
      <h3 data-v-26cbed55="" class="text-sm font-semibold">Cash direction</h3>
      <p data-v-26cbed55="" class="text-sm text-muted" data-testid="cash-direction-period">Selected period: Jan 1 – Jan 31, 2025</p>
      <p data-v-26cbed55="" class="net-overview-net is-positive">▲ $9.00 <span data-v-26cbed55="" class="net-overview-net__label">net in selected period</span></p>
      <p data-v-26cbed55="" class="text-sm text-muted"> Income $10.00 · Expenses $1.00</p>
    </div>
  </div><!-- Tier 2: Trend -->
  <div data-v-26cbed55="" class="daily-net-chart-panel net-overview-panel surface-normal p-5 md:p-6 flex flex-col gap-3 relative">
    <div data-v-26cbed55="" class="flex flex-wrap items-end justify-between gap-2">
      <p data-v-26cbed55="" class="text-sm text-muted" data-testid="selected-period">Selected period: Jan 1 – Jan 31, 2025</p>
      <div data-v-26cbed55="" class="date-range-stub"></div>
    </div>
    <div data-v-26cbed55="" class="daily-net-chart" show7-day="false" show30-day="false" show-avg-income="false" show-avg-expenses="false" show-comparison-overlay="false" comparison-mode="prior_month_to_date" timeframe="mtd">
      <div class="daily-net-chart__title-shell">
        <div data-v-26cbed55="" class="daily-net-chart-title-block">
          <h2 data-v-26cbed55="" class="daily-net-chart-title"><span data-v-26cbed55="" class="title-text">Net Income</span><span data-v-26cbed55="" class="title-subtitle">(Daily)</span></h2>
          <p data-v-26cbed55="" class="daily-net-chart-totals"> Income $10.00 · Expenses $1.00</p>
        </div>
      </div>
      <div class="daily-net-chart__controls-shell">
        <div data-v-26cbed55="" class="daily-net-chart-controls">
          <div data-v-26cbed55="" class="daily-net-chart-toolbar angular-chart-container"><button data-v-26cbed55="" class="chart-details-sidebar__toggle accent-toggle-btn chart-details-sidebar--inline" show7-day="false" show30-day="false" show-avg-income="false" show-avg-expenses="false" show-comparison-overlay="false" comparison-mode="prior_month_to_date">Overlays</button>
            <div data-v-26cbed55="" class="daily-net-timeframe-toggle" data-testid="daily-net-timeframe-toggle"><button data-v-26cbed55="" class="accent-toggle-btn angular-chart-chip daily-net-timeframe-btn accent-toggle-btn--active angular-chart-chip--active" type="button" aria-pressed="true"> MTD </button><button data-v-26cbed55="" class="accent-toggle-btn angular-chart-chip daily-net-timeframe-btn" type="button" aria-pressed="false"> Rolling 30 </button>
              <!--v-if-->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div data-v-26cbed55="" class="net-overview-summary-panel surface-quiet p-4 md:p-5">
    <div class="summary-slot">Custom Summary</div>
  </div>
</section>"
`;
